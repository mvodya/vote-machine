# Port for frontend
WEB_PORT=3000

# Port for frontend in dev container
WORKSPACE_WEB_PORT=3001
# Port for backend in dev container
WORKSPACE_API_PORT=8081
# Port for PostgreSQL in dev container
WORKSPACE_DB_PORT=5432

# Database password
POSTGRES_PASSWORD=vote_machine_local

# 32 random bytes in hex, stored outside PostgreSQL
ADMIN_LINK_KEY=

# Generate local keys with node scripts/setup-local-env.mjs
MEDIA_WORKER_KEY=
GARAGE_RPC_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_BUCKET=votebox-assets

# Leave empty when using an external S3 service
COMPOSE_PROFILES=local-storage
