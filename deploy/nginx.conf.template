# Keep private paths, cookies and query strings out of access logs
log_format safe_json escape=json '{"service":"edge","status":$status,"method":"$request_method","seconds":$request_time,"upstream":"$upstream_addr"}';
access_log /dev/stdout safe_json;
error_log /dev/stderr crit;
server_tokens off;
resolver 127.0.0.11 valid=2s ipv6=off;

upstream web_replicas {
  zone web_replicas 64k;
  server web:3000 resolve max_fails=1 fail_timeout=3s;
  keepalive 16;
}
upstream api_replicas {
  zone api_replicas 64k;
  server api:8080 resolve max_fails=1 fail_timeout=3s;
  keepalive 16;
}
server {
  listen 80;
  server_name _;
  location = /edge/live { access_log off; return 200 'alive'; }
  location / { return 308 ${PUBLIC_ORIGIN}$request_uri; }
}
server {
  listen 443 ssl;
  server_name _;
  ssl_certificate /run/tls/cert.pem;
  ssl_certificate_key /run/tls/key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 11m;
  add_header Strict-Transport-Security 'max-age=31536000' always;
  location / {
    proxy_pass http://web_replicas;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection '';
    # Replace any forwarded address sent by an outside client
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Forwarded '';
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 200s;
    proxy_send_timeout 30s;
    proxy_connect_timeout 2s;
    # Never replay a command after it may have reached the application
    proxy_next_upstream error timeout http_503;
    proxy_next_upstream_tries 2;
    proxy_next_upstream_timeout 4s;
  }
}
# This listener is private, only the web replicas call the API balance pool
server {
  listen 8080;
  server_name _;
  client_max_body_size 4m;
  location / {
    proxy_pass http://api_replicas;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 200s;
    proxy_connect_timeout 2s;
    proxy_next_upstream error timeout http_503;
    proxy_next_upstream_tries 2;
    proxy_next_upstream_timeout 4s;
  }
}
