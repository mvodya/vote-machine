{
  "name": "vote-machine",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "pnpm --filter @vote-machine/web test",
    "typecheck": "pnpm --filter @vote-machine/web typecheck",
    "build": "pnpm --filter @vote-machine/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter @vote-machine/web test:e2e",
    "dev:web": "pnpm --filter @vote-machine/web dev",
    "dev:api": "node scripts/dev-api.mjs",
    "lint": "pnpm --filter @vote-machine/web lint",
    "check:web": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "format:cpp": "sh scripts/format-cpp.sh --write",
    "format:cpp:check": "sh scripts/format-cpp.sh --check",
    "lint:cpp": "sh scripts/lint-cpp.sh",
    "test:tools": "node --test tests/dev-api.test.mjs",
    "db:migrate": "pnpm --filter @vote-machine/db migrate",
    "test:db": "sh tests/test-migrations.sh",
    "db:rollback": "pnpm --filter @vote-machine/db rollback"
  },
  "devDependencies": {
    "prettier": "3.8.1"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.25.0"
  }
}
